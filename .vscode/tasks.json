{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build app (g++)",
      "type": "process",
      "command": "C:/msys64/mingw64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "DoubleLinkedList.cpp",
        "DynamicArray.cpp",
        "SinglyLinkedList.cpp",
        "main.cpp",
        "-o",
        "app.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
