{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Projekt_3 (g++)",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/g++.exe",
            "args": [
                "-std=c++20",
                "-O2",
                "-Wall",
                "-Wextra",
                "main.cpp",
                "hash_chaining.cpp",
                "hash_open_addressing.cpp",
                "hash_avl.cpp",
                "-o",
                "app.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Projekt_3"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build app (g++)",
      "type": "process",
      "command": "C:/msys64/mingw64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "DoubleLinkedList.cpp",
        "DynamicArray.cpp",
        "SinglyLinkedList.cpp",
        "main.cpp",
        "-o",
        "app.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
